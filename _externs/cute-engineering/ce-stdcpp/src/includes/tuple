#pragma once

#include <cstddef>

namespace std {

template <typename T>
struct tuple_size;

template <size_t I, typename T>
struct tuple_element;

template <typename T>
inline constexpr size_t tuple_size_v = tuple_size<T>::value;

template <size_t I, typename T>
using tuple_element_t = tuple_element<I, T>::type;

} // namespace std